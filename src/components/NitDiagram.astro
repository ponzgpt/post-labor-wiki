---
// How a negative income tax works, with round illustrative numbers (not data): guarantee G, withdrawal rate t.
const G = 10, t = 0.5, maxE = 40; // thousands of dollars a year
const W = 640, H = 300, m = { l: 64, r: 24, t: 20, b: 44 };
const sx = (e: number) => m.l + (e / maxE) * (W - m.l - m.r);
const sy = (y: number) => m.t + (1 - y / maxE) * (H - m.t - m.b);
const breakEven = G / t;
const net = (e: number) => (e < breakEven ? G + e * (1 - t) : e);
const ticks = [0, 10, 20, 30, 40];
import Tag from './Tag.astro';
---
<figure class="frame infographic nit scroll-x">
  <div class="frame-head">
    <p class="frame-title">How a negative income tax works</p>
    <div class="frame-badges"><Tag kind="illustrative" /></div>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="nit-t nit-d">
    <title id="nit-t">How a negative income tax works (illustrative)</title>
    <desc id="nit-d">With an illustrative guarantee of $10,000 and a 50% withdrawal rate, a person with no earnings receives $10,000; each extra dollar earned reduces the payment by 50 cents, so net income always rises with work, until the payment reaches zero at $20,000 of earnings, the break-even point.</desc>
    {ticks.map((v) => (
      <g class="grid">
        <line x1={m.l} x2={W - m.r} y1={sy(v)} y2={sy(v)} />
        <text x={m.l - 8} y={sy(v) + 4} class="tick" text-anchor="end">${v}k</text>
        <text x={sx(v)} y={H - m.b + 18} class="tick" text-anchor="middle">${v}k</text>
      </g>
    ))}
    <text x={(m.l + W - m.r) / 2} y={H - 6} class="tick" text-anchor="middle">Earnings per year</text>
    <text x={14} y={sy(20)} class="tick" text-anchor="middle" transform={`rotate(-90 14 ${sy(20)})`}>Net income</text>
    <path d={`M${sx(0)} ${sy(0)} L${sx(maxE)} ${sy(maxE)}`} class="nit-base" />
    <path d={`M${sx(0)} ${sy(net(0))} L${sx(breakEven)} ${sy(net(breakEven))} L${sx(maxE)} ${sy(maxE)}`} class="nit-line" />
    <path d={`M${sx(0)} ${sy(0)} V${sy(G)}`} class="nit-gap" />
    <text x={sx(0) + 8} y={sy(G / 2)} class="nit-lab">Guarantee: $10k</text>
    <line x1={sx(breakEven)} x2={sx(breakEven)} y1={sy(breakEven)} y2={sy(0)} class="nit-drop" />
    <text x={sx(breakEven) + 6} y={sy(4)} class="nit-lab">Break-even: $20k</text>
    <text x={sx(0.6)} y={sy(23)} class="nit-lab nit-strong">With NIT: keeps 50¢ per extra $1</text>
    <text x={sx(26)} y={sy(26) + 22} class="nit-lab">No programme</text>
  </svg>
  <figcaption>Illustrative numbers, not a proposal or data: a $10,000 guarantee withdrawn at 50%. Drawing ours (CC BY 4.0).</figcaption>
</figure>
