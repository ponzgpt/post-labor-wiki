---
// A five-tier pyramid, base first. Used for Shapiro's two pyramids (Labor Zero plates 3 and 4); drawings ours.
interface Props {
  id: string;
  title: string;
  /** [name, gloss], base tier first. */
  tiers: [string, string][];
  /** Label for the base and the apex, e.g. ['Built first', 'Built last']. */
  axis: [string, string];
  dashedTop?: boolean;
  /** Both pyramids are Shapiro's proposals (value choices), drawn as illustrations. */
  kind?: 'normative' | 'analytical';
}
import Tag from './Tag.astro';
const { id, title, tiers, axis, dashedTop = false, kind = 'normative' } = Astro.props;
const H = 54, W = 640, top = 20, n = tiers.length;
---
<figure class="frame infographic pyramid">
  <div class="frame-head">
    <p class="frame-title">{title}</p>
    <div class="frame-badges"><Tag kind={kind} label={kind === 'normative' ? 'Normative · Shapiro' : undefined} /><Tag kind="illustrative" label="Drawing" /></div>
  </div>
  <svg viewBox={`0 0 ${W} ${top + n * H + 34}`} role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>{title}</title>
    <desc id={`${id}-d`}>{tiers.map(([name, sub], i) => `Tier ${i + 1}: ${name}, ${sub}.`).join(' ')} {axis[0]} at the base, {axis[1]} at the top.</desc>
    {tiers.map(([name, sub], i) => {
      const row = n - 1 - i;
      const y = top + row * H;
      const t = 60 + row * 50, b = t + 50;
      return (
        <g class={`pp-tier pp-${i}${dashedTop && i === n - 1 ? ' pp-dashed' : ''}`}>
          <path d={`M${W / 2 - t} ${y} H${W / 2 + t} L${W / 2 + b} ${y + H - 4} H${W / 2 - b} Z`} />
          <text x={W / 2} y={y + 22} class="ig-t ig-b">{i + 1}. {name}</text>
          <text x={W / 2} y={y + 40} class="ig-t ig-s">{sub}</text>
        </g>
      );
    })}
    <text x={W / 2} y={top + n * H + 22} class="ig-t ig-s">▲ {axis[0]} (base) to {axis[1]} (top)</text>
  </svg>
  <ol class="pp-list" aria-hidden="true">
    {tiers.map(([name, sub]) => <li><strong>{name}</strong>: {sub}</li>)}
  </ol>
  <figcaption><slot /></figcaption>
</figure>
