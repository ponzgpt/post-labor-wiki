---
// The Great Decoupling as two household income systems. Concept and the illustrative 60/20/20 → 20/80 income mix
// after Shapiro, Labor Zero (2026), plates 1–2 (© all rights reserved, so linked, not copied); drawing ours.
const before = [['Wages', 60], ['Transfers', 20], ['Capital', 20]] as const;
const after = [['Wages + transfers', 20], ['Capital', 80]] as const;
const bar = (parts: readonly (readonly [string, number])[], x: number, y: number, w: number) => {
  let at = x;
  return parts.map(([label, pct], i) => {
    const width = (pct / 100) * w;
    const seg = { label, pct, x: at, width, cls: label === 'Capital' ? 'ig-seg-cap' : i === 0 ? 'ig-seg-wage' : 'ig-seg-tr' };
    at += width;
    return seg;
  });
};
const b1 = bar(before, 20, 272, 320), b2 = bar(after, 390, 272, 320);
---
<figure class="infographic">
  <svg viewBox="0 0 720 340" role="img" aria-labelledby="dc-title dc-desc">
    <title id="dc-title">The Great Decoupling: from a wage-based to a capital-based household</title>
    <desc id="dc-desc">Today households sell labour to firms and are paid wages; in Shapiro's illustration about 60% of household income is wages, 20% transfers and 20% capital. After the decoupling, households own capital (firms, robots, AI, land, energy, funds) and receive dividends, interest and rents; his long-run target is 80% from capital and 20% from wages and transfers.</desc>
    <text x="180" y="26" class="ig-h ig-h-sm">Today: earn by working</text>
    <rect x="40" y="48" width="120" height="50" rx="25" class="ig-home" />
    <text x="100" y="78" class="ig-t ig-b">Households</text>
    <rect x="200" y="48" width="120" height="50" rx="8" class="ig-box ig-strong" />
    <text x="260" y="78" class="ig-t ig-b">Firms</text>
    <path d="M160 64 H196" class="ig-arrow" marker-end="url(#dc-ah)" />
    <text x="180" y="118" class="ig-t ig-s">labour →</text>
    <path d="M200 86 H164" class="ig-arrow" marker-end="url(#dc-ah)" />
    <text x="180" y="136" class="ig-t ig-s">← wages</text>

    <text x="550" y="26" class="ig-h ig-h-sm">Post-labor: earn by owning</text>
    <rect x="410" y="48" width="120" height="50" rx="25" class="ig-home" />
    <text x="470" y="78" class="ig-t ig-b">Households</text>
    <rect x="570" y="48" width="120" height="50" rx="8" class="ig-box ig-strong" />
    <text x="630" y="78" class="ig-t ig-b">Capital</text>
    <text x="550" y="166" class="ig-t ig-s">capital: firms, robots, AI, land, energy, funds</text>
    <path d="M530 64 H566" class="ig-arrow" marker-end="url(#dc-ah)" />
    <text x="550" y="118" class="ig-t ig-s">ownership (stock) →</text>
    <path d="M570 86 H534" class="ig-arrow" marker-end="url(#dc-ah)" />
    <text x="550" y="136" class="ig-t ig-s">← dividends, interest, rents (flow)</text>

    <path d="M335 120 H385" class="ig-arrow ig-big" marker-end="url(#dc-ah)" />
    <text x="180" y="258" class="ig-t ig-s">Household income mix today (illustrative)</text>
    <text x="550" y="258" class="ig-t ig-s">Long-run target (illustrative; W + T = wages and transfers)</text>
    {[...b1, ...b2].map((s) => (
      <g>
        <rect x={s.x} y="272" width={s.width - 2} height="40" rx="4" class={s.cls} />
        <text x={s.x + s.width / 2} y="290" class="ig-t ig-seg-t">{s.label === 'Wages + transfers' ? 'W + T' : s.label}</text>
        <text x={s.x + s.width / 2} y="306" class="ig-t ig-seg-t ig-b">{s.pct}%</text>
      </g>
    ))}
    <defs>
      <marker id="dc-ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="ig-ahead" />
      </marker>
    </defs>
  </svg>
  <figcaption>
    The Great Decoupling as Post-Labor Economics frames it. The two income mixes are Shapiro's illustrations, not measurements.
    Concept after David Shapiro, <a href="https://daveshap.github.io/PostLaborEconomics/laborzero/"><cite>Labor Zero</cite></a> (2026), plates 1–2; drawing ours (CC BY 4.0).
  </figcaption>
</figure>
