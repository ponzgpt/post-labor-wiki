---
// Vertical timeline from src/data/timeline.json: one card per milestone, each with its source. Building towards "now".
import Cite from './Cite.astro';
import events from '../data/timeline.json';

interface Props { kinds?: string[] }
const { kinds } = Astro.props;
const KIND = { idea: 'Idea', evidence: 'Measured', policy: 'Policy', technology: 'Technology', ple: 'Post-Labor Economics' };
const shown = events.filter((e) => !kinds || kinds.includes(e.kind));
const eras = [...new Set(shown.map((e) => e.era))];
---
<div class="timeline">
  <div class="tl-filter bib-filter" role="group" aria-label="Show milestones of one kind" data-pagefind-ignore>
    <button type="button" data-kind="" aria-pressed="true">All ({shown.length})</button>
    {Object.entries(KIND).map(([k, label]) => <button type="button" data-kind={k} aria-pressed="false">{label}</button>)}
  </div>
  {eras.map((era) => (
    <section class="tl-era" aria-labelledby={`era-${era.replace(/\W+/g, '-').toLowerCase()}`}>
      <h3 class="tl-era-h" id={`era-${era.replace(/\W+/g, '-').toLowerCase()}`}>{era}</h3>
      <ol class="tl-list">
        {shown.filter((e) => e.era === era).map((e) => (
          <li class={`tl-item tl-${e.kind}`}>
            <span class="tl-year">{e.when}</span>
            <div class="tl-card">
              <span class={`tl-kind tl-k-${e.kind}`}>{KIND[e.kind]}</span>
              <strong class="tl-title">{e.title}</strong>
              <p>{e.text} <Cite id={e.cite} at={e.at} /></p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tl-filter button');
  for (const b of buttons) {
    b.addEventListener('click', () => {
      const k = b.dataset.kind;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('.tl-item').forEach((li) => { li.hidden = !!k && !li.classList.contains(`tl-${k}`); });
      document.querySelectorAll<HTMLElement>('.tl-era').forEach((s) => { s.hidden = !s.querySelector('.tl-item:not([hidden])'); });
    });
  }
</script>
