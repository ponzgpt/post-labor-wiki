{
  "name": "post-labor-wiki",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --silent",
    "preview": "astro preview",
    "check": "node scripts/check.mjs && node --test src/lib/*.test.mjs && npm run build && node scripts/check-dist.mjs",
    "verify": "node scripts/verify-sources.mjs",
    "data": "node scripts/fetch-data.mjs",
    "brand": "node scripts/render-brand.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "astro": "7.4.8",
    "pagefind": "1.6.0"
  }
}
